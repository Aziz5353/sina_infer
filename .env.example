# --- OpenAI / LLM ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANALYZER_MODEL=gpt-4o-mini
CONTEXTUALIZE_MODEL=gpt-4o-mini
GENERATE_MODEL=gpt-5.1
REFUSE_MODEL=gpt-4o-mini

# Optional LLM knobs
# GENERATE_TEMPERATURE=0.2
# CONTEXTUALIZE_HISTORY_TURNS=6

# --- Embeddings ---
# HF_EMBEDDING_MODEL_NAME=BAAI/bge-m3
# HF_EMBEDDING_DEVICE=cpu

# --- Tavily web search ---
TAVILY_API_KEY=

# Optional search knobs
# SEARCH_ALLOWED_DOMAINS=mawdoo3.com,shamela.ws
# SEARCH_MAX_RESULTS=5
# SEARCH_MIN_RESULTS=2
# SEARCH_MIN_TOP_SCORE=0.50

# --- PGVector ---
PGVECTOR_CONNECTION=postgresql+psycopg://user:pass@host:5432/db
PGVECTOR_COLLECTION=aldiwan_poems

# Optional retrieval knobs
# RETRIEVAL_SCORE_THRESHOLD=0.60
# TOP_K_RETRIEVAL=8

# --- HTTP / CORS ---
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_TO_FILE=false
