# --- OpenAI / LLM ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANALYZER_MODEL=gpt-4o-mini
CONTEXTUALIZE_MODEL=gpt-4o-mini
ASSESS_MODEL=gpt-4o-mini
GENERATE_MODEL=gpt-5.1
CLARIFY_MODEL=gpt-4o-mini
REFUSE_MODEL=gpt-4o-mini

# Optional LLM knobs
# GENERATE_TEMPERATURE=0.1
# CONTEXTUALIZE_HISTORY_TURNS=6

# --- Tavily web search ---
TAVILY_API_KEY=

# Required: JSON list whitelist (wrap in single quotes to span lines). Sina never
# searches outside these domains and refuses to start when the list is empty.
SEARCH_ALLOWED_DOMAINS='[
  "ncbi.nlm.nih.gov", "who.int", "cdc.gov", "nice.org.uk",
  "medlineplus.gov", "merckmanuals.com", "ahajournals.org", "idsociety.org"
]'

# Optional search knobs
# SEARCH_MAX_RESULTS=5
# SEARCH_MIN_RESULTS=2
# SEARCH_QUERIES_PER_TURN=3
# MAX_SEARCH_ATTEMPTS=2

# --- Clarify ---
# MAX_CLARIFYING_QUESTIONS=4

# --- HTTP / CORS ---
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_TO_FILE=false
