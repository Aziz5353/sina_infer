# --- OpenAI / LLM ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PLAN_MODEL=gpt-4o-mini
ANSWER_MODEL=gpt-5.1

# --- Qwen / Local LLM (uncomment to use instead of the block above) ---
#OPENAI_BASE_URL=http://<qwen-host>:8000/v1
#PLAN_MODEL=qwen3
#ANSWER_MODEL=qwen3

# Optional LLM knobs
ANSWER_TEMPERATURE=0.1
HISTORY_TURNS=6

# --- Tavily web search ---
TAVILY_API_KEY=

# Required: JSON list whitelist (wrap in single quotes to span lines). Sina never
# searches outside these domains and refuses to start when the list is empty.
SEARCH_ALLOWED_DOMAINS='[
  "pubmed.ncbi.nlm.nih.gov", "ncbi.nlm.nih.gov", "europepmc.org",
  "cochranelibrary.com", "clinicaltrials.gov",
  "who.int", "cdc.gov", "nih.gov", "nice.org.uk", "ahrq.gov",
  "uspreventiveservicestaskforce.org", "sign.ac.uk", "ecdc.europa.eu",
  "acc.org", "ahajournals.org", "heart.org", "escardio.org",
  "diabetesjournals.org", "endocrine.org",
  "nccn.org", "asco.org", "esmo.org", "idsociety.org",
  "ginasthma.org", "goldcopd.org", "thoracic.org", "kdigo.org",
  "gastro.org", "gi.org", "rheumatology.org", "eular.org",
  "acog.org", "publications.aap.org", "aan.com", "psychiatry.org",
  "aafp.org", "acponline.org",
  "dailymed.nlm.nih.gov", "fda.gov", "accessdata.fda.gov",
  "ema.europa.eu", "bnf.nice.org.uk", "sfda.gov.sa", "moh.gov.sa",
  "nejm.org", "thelancet.com", "jamanetwork.com", "bmj.com",
  "acpjournals.org", "nature.com",
  "msdmanuals.com", "merckmanuals.com", "reference.medscape.com"
]'

# Optional search knobs
SEARCH_MAX_RESULTS=5
# SEARCH_QUERIES_PER_TURN=3
# SEARCH_MAX_SOURCES=10
# SEARCH_EXTRACT_TOP_K=4
# SEARCH_EXTRACT_MAX_CHARS=3000

# --- Clarify ---
# MAX_CLARIFYING_QUESTIONS=4

# --- Conversation dataset (for offline evaluation) ---
# Appends one row per /chat turn (message, answer, route, queries, sources, ...).
# Contains full clinical text; treat the file as sensitive.
SAVE_CONVERSATIONS=true
# Names the file: data/conversations_<GENERATION_MODEL_NAME>.csv
GENERATION_MODEL_NAME=gpt-5.1
# CONVERSATIONS_CSV_PATH=data/conversations.csv  # overrides the name above

# --- HTTP / CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Logging ---
LOG_LEVEL=DEBUG
LOG_TO_FILE=false
